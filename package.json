{
	"name": "types-schema",
	"description": "Turn your JSON schema into TypeScript code",
	"version": "0.0.1",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/**/*",
		"./schema.json"
	],
	"scripts": {
		"prepublishOnly": "bun run build",
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"check": "tsc --noEmit"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"dependencies": {},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/node": "20.17.24",
		"biome-md": "^0.0.6",
		"tsdown": "^0.15.10",
		"typescript": "5.6.3"
	},
	"peerDependencies": {},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": {
		"name": "Rajat Sandeep",
		"url": "https://rajatsandeepsen.github.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rajatsandeepsen/types-schema.git"
	},
	"bugs": {
		"url": "https://github.com/rajatsandeepsen/types-schema/issues"
	},
	"keywords": [
		"type",
		"schema",
		"typeschema",
		"typescript",
		"json",
		"jsonschema"
	]
}
