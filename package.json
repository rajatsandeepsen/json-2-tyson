{
	"name": "typeschema",
	"description": "Turn your JSON Schema to TypeScript",
	"version": "0.0.1",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/**/*"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"type-check": "tsc --noEmit"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./type": {
			"types": "./dist/type.d.ts"
		}
	},
	"dependencies": {},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/node": "20.17.24",
		"biome-md": "^0.0.6",
		"tsdown": "^0.15.10",
		"typescript": "5.6.3",
		"zod": "^3.25.67"
	},
	"peerDependencies": {
		"zod": "^3.0.0"
	},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": {
		"name": "Rajat Sandeep",
		"url": "https://rajatsandeepsen.github.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rajatsandeepsen/typeschema.git"
	},
	"bugs": {
		"url": "https://github.com/rajatsandeepsen/typeschema/issues"
	},
	"keywords": [
		"typeschema",
		"typescript",
		"json",
		"jsonschema"
	]
}
